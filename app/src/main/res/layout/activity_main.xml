<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 1. 全局永不遮挡的顶部常驻状态头 (PERMANENT TOP HEADER, 切换任何 Tab 始终可见) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AmapNavi-Reborn"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_navi_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="高德未连接"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_device_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="C3 未连接"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 2. 下方内容区域：FrameLayout 容器平滑切换 HUD 与 设置工作台 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <!-- 2.1 HUD 仪表内容区 (主页) -->
        <LinearLayout
            android:id="@+id/layout_hud_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:scrollbars="none"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btn_overtake"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:background="@drawable/shape_button"
                        android:text="@string/btn_overtake_on"
                        android:textColor="@color/success_green"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_cluster_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/btn_blue"
                        android:text="仪表投影"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/btn_blue"
                        android:text="通用设置"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_nav_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/btn_blue"
                        android:text="领航参数"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_overtake_setting"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/btn_blue"
                        android:text="超车模式"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_devices"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/shape_button"
                        android:text="设备管理"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_open_logs"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/shape_button"
                        android:text="日志管理"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <Button
                        android:id="@+id/btn_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/shape_button"
                        android:text="复位"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 核心交互区：左右分栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="6dp">

                <!-- 左栏：自车车速、巡航限速、路口与车道引导 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/shape_panel"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="自车车速"
                                android:textColor="@color/text_secondary"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/tv_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="0"
                                android:textColor="@color/text_primary"
                                android:textSize="76sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-8dp"
                                android:text="@string/label_kmh"
                                android:textColor="@color/text_secondary"
                                android:textSize="18sp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_cruise"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="巡航 -- km/h"
                                    android:textColor="@color/navi_blue"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_limit"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="限速 --"
                                    android:textColor="@color/text_primary"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_tbt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="路口 -- m"
                                android:textColor="@color/text_secondary"
                                android:textSize="16sp" />

                            <!-- 升级版醒目矢量信号灯徽章 -->
                            <TextView
                                android:id="@+id/tv_light"
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_marginTop="4dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:gravity="center"
                                android:background="@drawable/shape_button"
                                android:text="路口无信号灯"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/label_lane_guide"
                                android:textColor="@color/text_secondary"
                                android:textSize="15sp" />

                            <LinearLayout
                                android:id="@+id/lane_way_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal" />

                            <!-- 侧后盲区/侧向来车提醒（库斯途顶配电子后视镜式） -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tv_side_left"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:background="@drawable/shape_button"
                                    android:gravity="center"
                                    android:padding="6dp"
                                    android:text="左侧盲区"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="15sp" />

                                <TextView
                                    android:id="@+id/tv_side_right"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:background="@drawable/shape_button"
                                    android:gravity="center"
                                    android:padding="6dp"
                                    android:text="右侧盲区"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="15sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </ScrollView>

                    <!-- 定速巡航快捷微调 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_cruise_dec"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/shape_button"
                            android:text="−"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/tv_cruise_adjust"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="定速微调"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btn_cruise_inc"
                            android:layout_width="44dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/shape_button"
                            android:text="+"
                            android:textColor="@color/text_primary"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 右栏：多传感器雷达盲区 6 块卡片 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="多传感器盲区阵列"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp" />

                    <!-- 前方与侧向（3 列） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/radar_bsd_left"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_bsd_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="正常"
                                android:textColor="@color/success_green"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/shape_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/radar_lead"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_lead"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="无目标"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/shape_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/radar_bsd_right"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_bsd_right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="正常"
                                android:textColor="@color/success_green"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 后方激光与自车状态（3 列） -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/shape_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/radar_lidar_left"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_lidar_left"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="无目标"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/shape_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/radar_ego"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_ego"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center"
                                android:text="人工驾驶\nΔsteer 0.0°"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/shape_card"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/radar_lidar_right"
                                android:textColor="@color/text_muted"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_lidar_right"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="无目标"
                                android:textColor="@color/text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 底部：决策状态栏与动态追踪 Trace -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/shape_panel"
                android:orientation="vertical"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_overtake_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="待机"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_overtake_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="待机"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_trace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:text="系统就绪"
                    android:textColor="@color/text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2.2 全屏设置工作台 ViewStub (按需惰性加载，99% 行车时间零内存占用！) -->
        <ViewStub
            android:id="@+id/stub_settings_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/activity_setting" />

        <!-- 2.3 第一级仪表投影页面 ViewStub（覆盖层，避免 Activity 冷启动延迟） -->
        <ViewStub
            android:id="@+id/stub_cluster_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout="@layout/view_cluster_settings" />
    </FrameLayout>
</LinearLayout>
