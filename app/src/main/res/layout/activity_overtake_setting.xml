<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 顶部三段式导航 Tab -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_over_tab_general"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#333333"
                android:text="通用参数"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_over_tab_nav"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#333333"
                android:text="领航参数"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_over_tab_overtake"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#1976D2"
                android:text="超车参数"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 超车模式单选面板 (激进 / 常规 / 保守) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超车模式设置"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <RadioGroup
                android:id="@+id/rg_overtake_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_overtake_fast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="激进"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rb_overtake_normal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="常规"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rb_overtake_slow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="保守"
                    android:textColor="#FFFFFF" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <CheckBox
                    android:id="@+id/cb_overtake_highway"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="高速公路超车"
                    android:textColor="#FFFFFF" />

                <CheckBox
                    android:id="@+id/cb_overtake_road"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="普通公路超车"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- 侧向激光雷达防撞阈值 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="侧向安全与激光雷达阈值"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="12dp">

            <CheckBox
                android:id="@+id/cb_block_blocked_lane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目标道为禁行车道(X)时禁止超车"
                android:textColor="#FFFFFF" />

            <CheckBox
                android:id="@+id/cb_block_suggest_lane"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已有推荐车道(*)时禁止超车"
                android:textColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="后方安全时距门限 (秒):"
                android:textColor="#B0B0B0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_minus_rear_thresh"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:background="#333333"
                    android:text="-"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_rear_thresh"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="10.0"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_plus_rear_thresh"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:background="#333333"
                    android:text="+"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="米 (动态时距基准)"
                    android:textColor="#888888" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="相对逼近时距外推 (秒):"
                android:textColor="#B0B0B0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_minus_vrel_time"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:background="#333333"
                    android:text="-"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_vrel_time"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="4.0"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_plus_vrel_time"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:background="#333333"
                    android:text="+"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="秒 (后车追赶保护)"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- 反向变道防横跳冷却 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="反向变道防横跳冷却锁定"
            android:textColor="#00E676"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="超车完成或打轮接管后锁定时长 (秒)：防止刚变过去又变回来"
                android:textColor="#B0B0B0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btn_minus_cooldown"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:background="#333333"
                    android:text="-"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_cooldown"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="20"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_plus_cooldown"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:background="#333333"
                    android:text="+"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="秒"
                    android:textColor="#888888" />
            </LinearLayout>
        </LinearLayout>

        <!-- 底部保存与返回 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save_overtake"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#1976D2"
                android:text="保存配置"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btn_back_overtake"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="#333333"
                android:text="返回仪表"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
