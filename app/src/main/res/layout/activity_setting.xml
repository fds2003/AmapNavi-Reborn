<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- 顶部固定三段式导航 Tab (Fixed Tab Bar, 永不随内容滚动) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#1A1A1A"
        android:padding="6dp">

        <Button
            android:id="@+id/btn_tab_general"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_tab_selector"
            android:text="通用参数"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_tab_nav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_tab_selector"
            android:text="领航参数"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_tab_overtake"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_tab_selector"
            android:text="超车参数"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_back_general"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="#424242"
            android:minWidth="64dp"
            android:text="返回仪表"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 下方内容区域：通过 ViewFlipper 容纳三个独立的预测量容器 (毫秒级硬件缓存秒切) -->
    <ViewFlipper
        android:id="@+id/flipper_setting_tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 1. 100% 原始完整通用参数容器 -->
        <ScrollView
            android:id="@+id/container_tab_general"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:background="#000000">
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingContentLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="8dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbNaviTrafficAssist" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APP辅助停车(" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbCpTrafficAssist" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OP视觉辅助" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbRedLightTrafficAssist" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导航红灯辅助)" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbLaneDetect" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="车道线检测(" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbVideoShow" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示视频画面" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbLaneShow" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示车道线)" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbLaneTypePublish" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="实线结果发送给OP" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbVideoShowFast" android:padding="0dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="高帧率显示" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbLaneColor" android:padding="0dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="彩色画面" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp">
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbAppLog" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APP日志" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbAppSpeak" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="APP播报" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbTunnelDecSpeed" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="隧道强制减速" />
      <CheckBox android:textSize="13sp" android:textColor="#FFFFFFFF" android:id="@+id/cbSmoothSpeedLimit" android:padding="0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:text="平滑限速" />
    </LinearLayout>

    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/cbLayoutVisionLaneMode" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="2dp">
      <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="视觉车道识别: " />
      <RadioGroup android:orientation="horizontal" android:id="@+id/rgVisionLaneMode" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <RadioButton android:textSize="12sp" android:textColor="#FFFFFFFF" android:id="@+id/rbVisionLaneFastMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="快速" />
        <RadioButton android:textSize="12sp" android:textColor="#FFFFFFFF" android:id="@+id/rbVisionLaneNormalMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="标准" android:layout_marginStart="8dp" />
        <RadioButton android:textSize="12sp" android:textColor="#FFFFFFFF" android:id="@+id/rbVisionLaneSlowMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="保守" android:layout_marginStart="8dp" />
      </RadioGroup>
    </LinearLayout>


    <!-- 左右双列紧凑栅格布局 (8x8 对称通栏，彻底消除纵向滑动！) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">
      <!-- 左列：限速与控速参数 -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:layout_marginEnd="6dp">

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/cbLayoutCpMinSpeedLimt" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="视觉辅助目标速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etCpMinSpeedLimt" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="10" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusCpMinSpeedLimt" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusCpMinSpeedLimt" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/cbLayoutRedLightMinSpeedLimt" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="红灯辅助目标速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etRedLightMinSpeedLimt" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="20" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusRedLightMinSpeedLimt" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusRedLightMinSpeedLimt" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最高道路限速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etMaxSpeedLimit" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="130" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusMaxSpeedLimit" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusMaxSpeedLimit" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="最低道路限速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etMinSpeedLimit" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusMinSpeedLimit" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusMinSpeedLimit" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提高限速百分比:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etRoadSpeedLimitPercent" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusRoadSpeedLimitPercent" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusRoadSpeedLimitPercent" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提高限速绝对值:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etRoadSpeedLimitKph" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusRoadSpeedLimitKph" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusRoadSpeedLimitKph" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="高速低于60提速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etOffsetHighway" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusHighway" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusHighway" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="公路低于60提速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etOffsetRoad" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusRoad" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusRoad" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>
      </LinearLayout>
      <!-- 右列：场景、时距与位置参数 -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:layout_marginStart="6dp">

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/cbLayoutNaviTrafficAssistTime" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="辅助降速维持秒:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etNaviTrafficAssistTime" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusNaviTrafficAssistTime" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusNaviTrafficAssistTime" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/etLayoutLaneDetectInterval" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="车道线检测周期:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etLaneDetectInterval" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="500" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusLaneDetectInterval" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusLaneDetectInterval" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="收费站限速:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etStationSpeed" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusStationSpeed" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusStationSpeed" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="提前减速距离:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etStationDistOffset" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusStationDistOffset" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusStationDistOffset" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="过站后维持秒数:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etStationKeepTime" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusStationKeepTime" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusStationKeepTime" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="已靠边判定秒数:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etLastLaneSuppress" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="5" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusLastLaneSuppress" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusLastLaneSuppress" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="新车道出现秒数:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etNewLaneAppear" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusNewLaneAppear" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusNewLaneAppear" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>

        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="32dp">
          <TextView android:textSize="12sp" android:textColor="#FFFFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="APP顶部留空:" android:maxLines="1" />
          <EditText android:textSize="12sp" android:textColor="#00E676" android:gravity="center" android:id="@+id/etTopPad" android:background="#222222" android:layout_width="36dp" android:layout_height="26dp" android:text="0" android:inputType="number" android:padding="2dp" />
          <Button android:textSize="13sp" android:id="@+id/btnMinusTopPad" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="-" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
          <Button android:textSize="13sp" android:id="@+id/btnPlusTopPad" android:padding="0dp" android:layout_width="32dp" android:layout_height="26dp" android:minWidth="0dp" android:minHeight="0dp" android:text="+" android:layout_marginStart="4dp" android:textColor="#FFFFFFFF" android:background="#333333" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- 6 大原版按钮 100% 完整独立保留，2排×3个紧凑排布省空间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
